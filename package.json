{
  "name": "bb-plugin-cow",
  "version": "0.1.0",
  "description": "Run your work through one main thread and supervise it from one keyboard-driven page.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "cow",
    "description": "\ud83d\udc04 One Main thread, and one keyboard-driven page that shows everything it has delegated.",
    "branding": {
      "icon": "./assets/cow.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "themes": [
      {
        "id": "cow",
        "name": "cow",
        "description": "Paper and ink, light and dark: the look of cow's page for the whole app.",
        "css": "./themes/cow.css",
        "codeTheme": {
          "light": "vitesse-light",
          "dark": "vitesse-dark"
        }
      }
    ]
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
